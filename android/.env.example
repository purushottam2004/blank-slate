# Shared by the Android app. Copy to android/.env before building an APK
# that talks to a real backend. Unit tests do not read this file.
#
#   cp .env.example .env
#
# From an emulator, the host machine is 10.0.2.2, not 127.0.0.1.
# From a physical phone, use this computer's LAN address.

# Supabase connection related
SUPABASE_URL=http://10.0.2.2:54321
SUPABASE_PUBLISHABLE_KEY=

# Backend connection related
BACKEND_URL=http://10.0.2.2:8080
