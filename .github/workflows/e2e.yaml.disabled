name: E2E Tests (Playwright)

on:
  push:
    branches:
      - main
      - stage
    paths:
      - 'e2e/**'
      - 'frontend/**'
      - 'backend/**'
      - 'supabase/**'
  pull_request:
    paths:
      - 'e2e/**'
      - 'frontend/**'
      - 'backend/**'
      - 'supabase/**'
  workflow_dispatch:

permissions:
  contents: read

jobs:
  e2e:
    runs-on: ubuntu-latest
    steps:
      - name: Checkout repository
        uses: actions/checkout@v4

      - name: Setup pnpm
        uses: pnpm/action-setup@v4
        with:
          version: 11.17.0

      - name: Setup Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 22
          cache: "pnpm"
          cache-dependency-path: frontend/pnpm-lock.yaml

      - name: Setup Python
        uses: actions/setup-python@v5
        with:
          python-version: "3.13"
          cache: pip
          cache-dependency-path: |
            backend/requirements.txt
            supabase/requirements.txt

      - name: Install frontend dependencies
        working-directory: frontend
        run: pnpm install --frozen-lockfile

      - name: Install e2e dependencies
        working-directory: e2e
        run: npm ci

      - name: Install Supabase CLI
        uses: supabase/setup-cli@v1
        with:
          version: latest

      - name: Start local Supabase
        working-directory: supabase
        run: supabase start

      - name: Get Supabase credentials
        id: supabase
        working-directory: supabase
        run: |
          echo "url=$(supabase status --output json | jq -r '.API_URL')" >> $GITHUB_OUTPUT
          echo "publishable_key=$(supabase status --output json | jq -r '.PUBLISHABLE_KEY')" >> $GITHUB_OUTPUT
          echo "secret_key=$(supabase status --output json | jq -r '.SECRET_KEY')" >> $GITHUB_OUTPUT

      - name: Seed test data
        working-directory: supabase
        env:
          SUPABASE_URL: ${{ steps.supabase.outputs.url }}
          SUPABASE_PUBLISHABLE_KEY: ${{ steps.supabase.outputs.publishable_key }}
          SUPABASE_SECRET_KEY: ${{ steps.supabase.outputs.secret_key }}
        run: |
          python -m pip install --root-user-action=ignore -r requirements.txt
          python seed.py

      - name: Start backend
        working-directory: backend
        env:
          SUPABASE_URL: ${{ steps.supabase.outputs.url }}
          SUPABASE_PUBLISHABLE_KEY: ${{ steps.supabase.outputs.publishable_key }}
          SUPABASE_SECRET_KEY: ${{ steps.supabase.outputs.secret_key }}
          DEPLOYMENT_ENV: LOCAL
        run: |
          python -m pip install --upgrade pip
          pip install -r requirements.txt
          nohup python main.py > /tmp/backend.log 2>&1 &
          timeout 60 bash -c 'until curl -sf http://127.0.0.1:8080/ >/dev/null; do sleep 1; done' || (echo "Backend failed to start. Logs:" && cat /tmp/backend.log && exit 1)

      - uses: actions/cache@v4
        with:
          path: ~/.cache/ms-playwright
          key: playwright-${{ runner.os }}

      - name: Run E2E tests
        env:
          VITE_SUPABASE_URL: ${{ steps.supabase.outputs.url }}
          VITE_SUPABASE_PUBLISHABLE_KEY: ${{ steps.supabase.outputs.publishable_key }}
          VITE_BACKEND_URL: http://127.0.0.1:8080
          API_URL: http://127.0.0.1:8080
          SUPABASE_URL: ${{ steps.supabase.outputs.url }}
          SUPABASE_PUBLISHABLE_KEY: ${{ steps.supabase.outputs.publishable_key }}
          SUPABASE_SECRET_KEY: ${{ steps.supabase.outputs.secret_key }}
          CI: "true"
        working-directory: e2e
        run: |
          npx playwright install --with-deps chromium
          npx playwright test

      - uses: actions/upload-artifact@v4
        if: always()
        with:
          name: playwright-report
          path: e2e/playwright-report/
          retention-days: 30

      - name: Stop Supabase
        if: always()
        working-directory: supabase
        run: supabase stop
