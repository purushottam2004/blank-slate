# Shared by all apps under frontend/.
# App-specific vars go in apps/<app>/.env (and override these on conflict).
#
#   cp .env.example .env

# Supabase connection related
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=

# Backend connection related
VITE_BACKEND_URL=http://127.0.0.1:8080

# Google OAuth uses window.location.origin and supabase/config.toml
# additional_redirect_urls. Enable [auth.external.google] there; no extra
# Vite key is required. Phone OTP uses Supabase Auth SMS (also disabled
# by default in config.toml).
