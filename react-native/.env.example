# Shared by the Expo app. Copy to react-native/.env before starting Metro.
#
#   cp .env.example .env
#
# iOS simulator and Expo web can use 127.0.0.1.
# The Android emulator cannot. The app rewrites 127.0.0.1 and localhost
# to 10.0.2.2 when it is running on Android.
# From a physical phone, replace both hosts with this computer's LAN address.
# The rewrite does not touch a LAN address.

# Supabase connection related
EXPO_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Backend connection related
EXPO_PUBLIC_BACKEND_URL=http://127.0.0.1:8080
